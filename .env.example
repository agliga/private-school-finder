DATABASE_URL=postgresql://schools:schools@localhost:5432/schools
ANTHROPIC_API_KEY=
# Cheap model for page extraction, stronger model for the query agent
EXTRACT_MODEL=claude-haiku-5-5
# Plain-English -> filters for `find`
TRANSLATE_MODEL=claude-haiku-5-5
AGENT_MODEL=claude-sonnet-5-5
EMBED_MODEL=BAAI/bge-small-en-v1.5
CRAWL_USER_AGENT=school-finder/0.1 (+https://github.com/agliga/private-school-finder)

# Travel times (optional)
# Traffic-aware drive times: Google Maps Platform key with the Routes API enabled
GOOGLE_MAPS_API_KEY=
# Used for "from home", and as a fallback for "my current location"
HOME_ADDRESS=
TIMEZONE=America/Los_Angeles
# Morning drive leaves this many minutes before the school's start time
MORNING_LEAD_MINUTES=30
# Used when a school hasn't published its bell schedule
DEFAULT_START_TIME=08:00
DEFAULT_END_TIME=15:00
# Max schools per search to compute drive times for (cost guard)
MAX_ROUTE_SCHOOLS=25
