DATABASE_URL=postgresql://schools:schools@localhost:5432/schools
ANTHROPIC_API_KEY=
# Cheap model for page extraction, stronger model for the query agent
EXTRACT_MODEL=claude-haiku-5-5
# Plain-English -> filters for `find`
TRANSLATE_MODEL=claude-haiku-5-5
AGENT_MODEL=claude-sonnet-5-5
EMBED_MODEL=BAAI/bge-small-en-v1.5
CRAWL_USER_AGENT=school-finder/0.1 (+https://github.com/agliga/private-school-finder)
